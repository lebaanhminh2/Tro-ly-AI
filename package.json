{
  "name": "telegram-assistant-ai-trial",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=2 tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:experiments": "node --test experiments/ai-trial/*.test.ts",
    "test:all": "npm run test && npm run test:experiments",
    "dev": "wrangler dev --local",
    "db:local": "wrangler d1 migrations apply assistant-local --local",
    "build:check": "wrangler deploy --env \"\" --dry-run",
    "staging:check": "node --test tests/unit/staging-config.test.ts && wrangler deploy --env staging --dry-run",
    "deploy:staging": "node tests/unit/staging-config.test.ts --require-ready && wrangler deploy --env staging",
    "db:staging": "node tests/unit/staging-config.test.ts --require-ready && wrangler d1 migrations apply DB --env staging --remote",
    "try:ai": "node experiments/ai-trial/try-ai.ts",
    "typecheck": "tsc --noEmit",
    "check:web": "node scripts/check-web.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "lint": "eslint src web scripts/*.mjs eslint.config.mjs",
    "format:check": "node scripts/format.mjs --check",
    "format": "node scripts/format.mjs --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "miniflare": "^4.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  }
}
