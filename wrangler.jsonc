{
  "name": "personal-assistant-trial",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "AI_MODE": "off" },
  "d1_databases": [{ "binding": "DB", "database_name": "assistant-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "env": {
    "staging": {
      "name": "personal-assistant-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "AI_MODE": "on",
        "GEMINI_MODEL": "gemini-3.5-flash-lite",
        "DELIVERY_MODE": "outbox"
      },
      "triggers": { "crons": ["* * * * *"] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "assistant-staging",
        "database_id": "5457c401-45d9-4b19-b76e-0eceec67a223",
        "migrations_dir": "migrations"
      }]
    }
  }
}
